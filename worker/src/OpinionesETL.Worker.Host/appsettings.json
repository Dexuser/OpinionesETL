{
  "Worker": {
    "Modo": "UnaVez",
    "IntervaloMinutos": 60
  },
  "ConnectionStrings": {
    "Operacional": "Host=localhost;Port=5432;Database=opiniones_clientes;Username=postgres",
    "Analitica": "Host=localhost;Port=5432;Database=opiniones_clientes;Username=postgres"
  },
  "Fuentes": {
    "Csv": {
      "Habilitado": true,
      "Carpeta": "data",
      "Patron": "surveys_*.csv"
    },
    "BaseOperacional": {
      "Habilitado": true
    },
    "Api": {
      "Habilitado": true,
      "BaseUrl": "http://localhost:5080",
      "Ruta": "api/comentarios-sociales",
      "NombreHeaderApiKey": "X-API-Key",
      "TamanioPagina": 100,
      "TimeoutSegundos": 30,
      "Reintentos": 3,
      "EsperaInicialMs": 500
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System.Net.Http": "Warning" }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": { "path": "logs/etl-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  }
}
